#%Module1.0#####################################################################
##
## Parasites and Microbes metawrap_qc_nextflow {{version}}
##

# help setup
proc ModulesHelp { } {
  global version modroot

  puts stderr "Custom deployment managed by pathogen informatics: {{path}}"
  puts stderr "Executables:"
  puts stderr "\tmetawrap_qc_nextflow"
  puts stderr "Home page: {{repo_url}}"
}

# Whatis setup
module-whatis "Custom deployment managed by pathogen informatics: {{path}}"
module-whatis "Executables:"
module-whatis "metawrap_qc_nextflow"

# Load prerequisite modules
module switch nextflow
module switch ISG/singularity
module load ISG/IRODS

# Load message
if { [ module-info mode load ] } {
    puts stderr "\tModule loaded. For more information run 'module help metawrap_qc_nextflow/{{version}}'."
}

# Conflicts
conflict metawrap_qc_nextflow

# Add wrappers to PATH
prepend-path PATH "{{path}}/metawrap_qc_nextflow"

